---
import Base from '../layouts/Base.astro';
import { backlog, number } from '../lib/data';
import { categories, statuses } from '../lib/backlog.mjs';
import { getArticles } from '../lib/articles';
const visible = new Set((await getArticles()).map((article) => article.id));
---
<Base title="خريطة البحث" description="الأسئلة المفتوحة والموضوعات قيد البحث والمسودات والمراجعات، مع الخطوة التالية لكل موضوع.">
  <div class="container"><header class="page-heading"><span class="eyebrow">سجل العمل المفتوح</span><h1>خريطة البحث</h1><p class="lead">{number(backlog.length)} موضوعًا، في مراحل مختلفة. وجود السؤال هنا لا يعني ثبوت نتيجته؛ تبيّن كل بطاقة ما نعرفه الآن وما يحتاج إلى فحص.</p></header>
    <div class="filter-links" aria-label="مراحل البحث">{Object.entries(statuses).map(([key, title]) => <span class:list={['badge', `status-${key}`]}>{title} · {number(backlog.filter((topic) => topic.status === key).length)}</span>)}</div>
    <nav class="filter-links" aria-label="أقسام البحث">{Object.entries(categories).map(([key, title]) => <a href={`#${key}`}>{title}</a>)}</nav>
    {Object.entries(categories).map(([key, title]) => <section class="topic-group" id={key}><h2>{title}</h2>{backlog.filter((topic) => topic.category === key).map((topic) => <details class="topic" id={topic.id}><summary><h3>{topic.title_ar}</h3><span class:list={['badge', `status-${topic.status}`]}>{statuses[topic.status as keyof typeof statuses]}</span></summary><div class="topic-body"><p><strong>السؤال: </strong>{topic.question_ar}</p><p><strong>ما نعرفه: </strong>{topic.baseline_ar}</p><p class="qualification">{topic.qualification_ar}</p><p><strong>الخطوة التالية: </strong>{topic.next_step_ar}</p>{topic.verse_refs.length > 0 && <div class="verse-refs" aria-label="مواضع الآيات">{topic.verse_refs.map((ref) => <bdi dir="ltr">{ref}</bdi>)}</div>}<div class="topic-links">{topic.article_slug && visible.has(topic.article_slug) && <a href={`/articles/${topic.article_slug}/`}>اقرأ المقال ←</a>}{topic.evidence_ids.map((id, index) => <a href={`/evidence/${id}.json`} download>سجل الدليل {number(index + 1)} ↓</a>)}{topic.source_urls.map((url, index) => <a href={url}>مصدر {number(index + 1)} ↗</a>)}</div></div></details>)}</section>)}
  </div>
</Base>
