---
import Base from '../layouts/Base.astro';
import { readJSON, number, manifest } from '../lib/data';
const words = readJSON('reports/repetition-summary.json');
const simple = readJSON('reports/characters-simple-clean.json');
const uthmani = readJSON('reports/characters-uthmani.json');
const universe = readJSON('reports/universe.json');
---
<Base title="العدّ والألفاظ" description="نتائج عد قابلة لإعادة الحساب، مع تحديد الوحدة والرسم والصيغ المشمولة وسياسة البسملة.">
  <div class="container"><header class="page-heading"><span class="eyebrow">نتائج قابلة للفحص</span><h1>ماذا نعدّ؟</h1><p class="lead">يتغير العدد بتغير الوحدة والرسم وقاعدة الجمع. نعرض القاعدة مع النتيجة؛ ولا يحوّل تساوي عددين الملاحظة وحدها إلى برهان على معنى أو علاقة علمية.</p></header>
    <aside class="notice"><strong>قاعدة القراءة قبل الأرقام</strong><p>{words.method_ar}</p><p><strong>الرسم: </strong>تنزيل المبسط المنظّف (Simple Clean)، مع مقارنة مستقلة للرسم العثماني أدناه.</p><p><strong>البسملة: </strong>{manifest.basmala_policy_ar}</p></aside>
    <section class="section" id="written-words"><div class="section-header"><div><span class="eyebrow">وحدة العد: كلمة مفصولة بمسافة</span><h2>الصيغ المكتوبة وتكرارها</h2></div></div><div class="stats-grid"><div class="stat"><strong>{number(words.tokens)}</strong><span>موضع كلمة مكتوبة</span></div><div class="stat"><strong>{number(words.written_forms)}</strong><span>صيغة مكتوبة مختلفة</span></div><div class="stat"><strong>{number(words.forms_occurring_once)}</strong><span>صيغة وردت مرة واحدة</span></div></div><p class="small muted">تبقى اللواصق متصلة كما كتبت؛ لذلك «من» و«ومن» صيغتان في هذه النتيجة. لا يدل عد الصيغة على عدد جذورها أو معانيها.</p><div class="table-wrap" tabindex="0" role="region" aria-label="الصيغ الأكثر تكرارا"><table><caption>أول عشر صيغ بحسب تكرارها في التقرير</caption><thead><tr><th scope="col">الصيغة المكتوبة</th><th scope="col">مرات الظهور</th></tr></thead><tbody>{words.top_forms.slice(0, 10).map((item: { word: string; count: number }) => <tr><td>{item.word}</td><td>{number(item.count)}</td></tr>)}</tbody></table></div><a class="text-link" href="/downloads/repetition-summary.json" download>تحميل تقرير التكرار وقاعدته ↓</a></section>
    <section class="section" id="characters"><div class="section-header"><div><span class="eyebrow">وحدة العد: نقطة Unicode</span><h2>الرسم يغيّر ما يُعدّ</h2></div></div><p class="small muted">{simple.method_ar}</p><div class="table-wrap" tabindex="0" role="region" aria-label="مقارنة ترميز الرسمين"><table><thead><tr><th scope="col">الوحدة</th><th scope="col">المبسط المنظّف</th><th scope="col">العثماني</th></tr></thead><tbody><tr><th scope="row">الرموز غير البيضاء</th><td>{number(simple.non_whitespace_codepoints)}</td><td>{number(uthmani.non_whitespace_codepoints)}</td></tr><tr><th scope="row">الحروف عدا التطويل</th><td>{number(simple.letter_codepoints_excluding_tatweel)}</td><td>{number(uthmani.letter_codepoints_excluding_tatweel)}</td></tr><tr><th scope="row">العلامات</th><td>{number(simple.mark_codepoints)}</td><td>{number(uthmani.mark_codepoints)}</td></tr><tr><th scope="row">التطويل</th><td>{number(simple.tatweel_codepoints)}</td><td>{number(uthmani.tatweel_codepoints)}</td></tr></tbody></table></div><div class="downloads"><a href="/downloads/characters-simple-clean.json" download>تقرير الرسم المبسط ↓</a><a href="/downloads/characters-uthmani.json" download>تقرير الرسم العثماني ↓</a></div></section>
    <section class="section" id="universe"><div class="section-header"><div><span class="eyebrow">مجموعات لفظية محددة</span><h2>ألفاظ السماء والأرض وما يتصل بها</h2></div></div><p class="lead">هذه أعداد الصيغ المدرجة، وليست أعداد الإشارات إلى مفهوم الكون الحديث. افتح المجموعة لترى صيغها والتحفظات الدلالية.</p>{universe.groups.map((group: any) => <details class="topic"><summary><h3>{group.title_ar}</h3><span class="badge">{number(group.count)} ظهورًا · {number(group.matching_verses)} آية</span></summary><div class="topic-body"><p>{group.scope_note_ar}</p><p><strong>الصيغ المشمولة: </strong>{group.terms.join('، ')}</p><p class="qualification">{group.semantic_caveats_ar.join(' ')}</p>{group.excluded_candidate_forms.length > 0 && <p class="small muted"><strong>مرشحات مستبعدة: </strong>{group.excluded_candidate_forms.join('، ')}</p>}<div class="table-wrap"><table><thead><tr><th scope="col">الصيغة</th><th scope="col">العدد</th></tr></thead><tbody>{group.forms.map((form: any) => <tr><td>{form.form}</td><td>{number(form.count)}</td></tr>)}</tbody></table></div></div></details>)}<div class="downloads"><a href="/downloads/universe.json" download>تحميل التقرير الكامل مع المواضع والسياقات ↓</a><a href="/downloads/audit.json" download>تحميل سجل التدقيق الحسابي ↓</a></div></section>
    <p class="small muted spaced">المصدر: <a href="https://tanzil.net/">مشروع تنزيل</a> · <a href="/source-license.txt">الإشعار وشروط الاستخدام</a>. تحفظ ملفات التقارير بصمة المصدر وطريقة العد، وتتضمن إشعار المصدر.</p>
  </div>
</Base>
